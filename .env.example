# Copy to `.env` next to compose.yaml, fill in the two required lines, and
# never commit the result. `compose.yaml` reads everything from here, so it
# does not need editing.

# ── Required ─────────────────────────────────────────────────────────────────

# The directory holding your stacks: one directory per stack, each with one
# Compose file. An absolute path — `~` does not expand here.
#
# compose.yaml uses this value for both the container's configuration and the
# bind mount, so the path is identical inside and outside. That is not a
# nicety: your Compose files use relative bind mounts (./data:/data) that the
# *host* daemon resolves. See the README.
SHIMAU_STACKS_DIR=/home/you/docker-apps

# Bootstrap password, read once on the first boot to create the administrator.
# At least 12 characters. Afterwards it is ignored and this line can go.
#   openssl rand -base64 24
SHIMAU_ADMIN_PASSWORD=change-me-to-something-long

# ── Optional ─────────────────────────────────────────────────────────────────

# SHIMAU_ADMIN_USERNAME=admin

# Uncomment when you reach shimau over plain http:// — a LAN address, no
# reverse proxy. The browser silently drops a Secure cookie on an insecure
# connection, and the symptom is a login that appears to work and immediately
# returns you to the form. Leave it alone behind TLS.
# SHIMAU_COOKIE_SECURE=false

# How long a session lasts. 168 hours is a week.
# SHIMAU_SESSION_TTL_HOURS=168

# `tracing` filter: error, warn, info, debug, trace.
# SHIMAU_LOG=info
